SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of emails allowed to use the admin panel. A valid
# Supabase login alone is not enough — this is checked on every admin route.
ADMIN_EMAILS=you@example.com

# Comma-separated list of frontend origins allowed to call this API
# (e.g. https://dickenspub.no). Leave unset only for local development —
# CORS falls back to allowing any origin when empty.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Set to "production" when deployed so the app enforces HTTPS redirects.
NODE_ENV=development
